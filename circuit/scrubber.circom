pragma circom 2.1.4;

include "node_modules/circomlib/circuits/poseidon.circom";
include "node_modules/circomlib/circuits/mux1.circom";
include "node_modules/circomlib/circuits/comparators.circom";
include "node_modules/circomlib/circuits/eddsaposeidon.circom";

// -----------------------------------------------------------------------------
// RealPeep: Zero-Knowledge Identity Scrubber Circuit
// -----------------------------------------------------------------------------
// This circuit proves that a video payload was captured by an authorized 
// hardware TEE (Trusted Execution Environment) without revealing the specific 
// identity of the hardware.
// 
// Private Inputs:
// - tee_pubkey: The real public key of the hardware sensor.
// - tee_sig_R, tee_sig_S: The EdDSA signature generated by the hardware over the payload.
// - merkle_path_elements: The sibling nodes in the authorized hardware Merkle Tree.
// - merkle_path_indices: The directional path indices for the Merkle Proof.
// 
// Public Inputs:
// - payload_hash: The Poseidon hash of the video/mesh payload.
// - ephemeral_pubkey: A randomly generated key to act as the anonymous identity.
// - authorized_merkle_root: The public root of all valid Apple/Google TEE keys.
// -----------------------------------------------------------------------------

template MerkleTreeInclusionProof(levels) {
    signal input leaf;
    signal input pathElements[levels];
    signal input pathIndices[levels];
    signal output root;

    component hashers[levels];
    component mux[levels][2];

    signal levelHashes[levels + 1];
    levelHashes[0] <== leaf;

    for (var i = 0; i < levels; i++) {
        // Ensure path index is boolean
        pathIndices[i] * (1 - pathIndices[i]) === 0;

        hashers[i] = Poseidon(2);
        mux[i][0] = Mux1();
        mux[i][1] = Mux1();

        // Left node selection
        mux[i][0].c[0] <== levelHashes[i];
        mux[i][0].c[1] <== pathElements[i];
        mux[i][0].s <== pathIndices[i];
        hashers[i].inputs[0] <== mux[i][0].out;

        // Right node selection
        mux[i][1].c[0] <== pathElements[i];
        mux[i][1].c[1] <== levelHashes[i];
        mux[i][1].s <== pathIndices[i];
        hashers[i].inputs[1] <== mux[i][1].out;

        levelHashes[i + 1] <== hashers[i].out;
    }

    root <== levelHashes[levels];
}

template ZKIdentityScrubber(merkle_levels) {
    // --- Public Inputs ---
    signal input payload_hash;
    signal input ephemeral_pubkey;
    signal input authorized_merkle_root;

    // --- Private Inputs ---
    signal input tee_pubkey_x;
    signal input tee_pubkey_y;
    signal input tee_sig_Rx;
    signal input tee_sig_Ry;
    signal input tee_sig_S;
    
    signal input merkle_path_elements[merkle_levels];
    signal input merkle_path_indices[merkle_levels];

    // ----------------------------------------------------
    // 1. Verify Hardware Signature over Payload Hash
    // ----------------------------------------------------
    component sigVerifier = EdDSAPoseidonVerifier();
    sigVerifier.enabled <== 1;
    sigVerifier.Ax <== tee_pubkey_x;
    sigVerifier.Ay <== tee_pubkey_y;
    sigVerifier.R8x <== tee_sig_Rx;
    sigVerifier.R8y <== tee_sig_Ry;
    sigVerifier.S <== tee_sig_S;
    sigVerifier.M <== payload_hash;

    // ----------------------------------------------------
    // 2. Verify TEE is in the Authorized Merkle Tree
    // ----------------------------------------------------
    // First, hash the pubkey coordinates to get the leaf
    component leafHasher = Poseidon(2);
    leafHasher.inputs[0] <== tee_pubkey_x;
    leafHasher.inputs[1] <== tee_pubkey_y;

    // Prove inclusion
    component treeVerifier = MerkleTreeInclusionProof(merkle_levels);
    treeVerifier.leaf <== leafHasher.out;
    for (var i = 0; i < merkle_levels; i++) {
        treeVerifier.pathElements[i] <== merkle_path_elements[i];
        treeVerifier.pathIndices[i] <== merkle_path_indices[i];
    }

    // The calculated root MUST match the public authorized root
    treeVerifier.root === authorized_merkle_root;

    // ----------------------------------------------------
    // 3. Cryptographic Binding (Square the inputs)
    // ----------------------------------------------------
    // We explicitly square the public inputs in a dummy constraint to ensure 
    // the compiler does not optimize them away, formally binding the 
    // ephemeral pubkey and payload hash to the ZK proof.
    signal dummy1 <== payload_hash * payload_hash;
    signal dummy2 <== ephemeral_pubkey * ephemeral_pubkey;
    signal dummy3 <== authorized_merkle_root * authorized_merkle_root;
}

// Instantiate the main circuit with a Merkle Tree depth of 20 
// (Supports up to 1,048,576 authorized hardware sensors)
component main {public [payload_hash, ephemeral_pubkey, authorized_merkle_root]} = ZKIdentityScrubber(20);
